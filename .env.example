# Credential Management
# Copy this file to .env and fill in your actual values
# .env is in .gitignore - never commit real credentials

# ===== APPLE APP STORE CONNECT =====

# Apple ID for App Store Connect
APPLE_ID=your-apple-id@example.com

# App Store Connect API Key ID
ASC_KEY_ID=XXXXXXXXXX

# App Store Connect Issuer ID
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Path to App Store Connect API private key (.p8 file)
# Download from: https://appstoreconnect.apple.com/access/api
ASC_KEY_PATH=./AuthKey_XXXXXXXXXX.p8

# ===== GOOGLE PLAY STORE =====

# Google Play service account email
GOOGLE_PLAY_EMAIL=play-store-submit@project.iam.gserviceaccount.com

# Path to Google service account JSON key
# Download from: https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_SERVICE_ACCOUNT_PATH=./google-service-account.json

# ===== FASTLANE =====

# Fastlane match credentials (for certificate management)
MATCH_PASSWORD=your_secure_password_here
MATCH_GIT_BASIC_AUTHORIZATION=base64_encoded_credentials_here

# ===== TESTING & CI/CD =====

# Set to 'true' to skip interactive prompts in CI/CD
CI=false

# Enable verbose logging
VERBOSE=false
