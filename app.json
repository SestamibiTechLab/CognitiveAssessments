{
  "expo": {
    "name": "Cognitive Assessments",
    "slug": "cognitive-assessments",
    "version": "1.0.12",
    "orientation": "sensor",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#dbe7f3"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sestamibitechlab.cognitiveassessments",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.sestamibitechlab.slums",
      "versionCode": 13,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#dbe7f3"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "assetBundlePatterns": [
      "assets/**"
    ],
    "plugins": [
      "expo-av"
    ],
    "extra": {
      "eas": {
        "projectId": "a14cd138-02b3-458e-91a9-ab4eb8cac675"
      }
    },
    "owner": "sestamibi"
  }
}
